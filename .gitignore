# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local archive database
/data
.update.lock

# fetched by npm run art:fetch, not committed. Both are baked into the image by
# COPY /app/public at build time, so what matters is that they are on disk when
# update.ps1 runs — not that they are in git. Two thousand untracked PNGs made
# `git status` unreadable and buried real changes in the noise.
#
# The ascendancy *portraits* under /public/ascendancy/ are committed, and are
# deliberately not covered here: see the rule in CLAUDE.md.
/public/ascendancy.webp
/public/items/

# written by collect.ps1: one export per account, kept so collection stays incremental
/collect

# written by watch.ps1
/logs
